[resource]
script = ExtResource("1_serpent_shot")
ContentId = "ability.core.serpent_shot"
DisplayName = "Serpent Shot"
Description = "Replace the next basic ranged attack with a poison arrow that damages its target once per second for ten seconds."
CooldownSeconds = 10.0
CastTimeSeconds = 0.0
Range = 180.0
HitCheckMode = 1
EffectType = 3
BaseDamage = 5.0
EffectDurationSeconds = 10.0
DesignerNotes = "Automatically replaces the Hunter's next basic attack when ready. The poison begins one second after projectile impact, deals ten ticks, refreshes on reapplication by the same Hunter, and does not deal immediate impact damage."
