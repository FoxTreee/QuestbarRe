[resource]
script = ExtResource("1_heal")
ContentId = "ability.core.heal"
DisplayName = "Heal"
Description = "Restore health to the living party member with the lowest health percentage below the automatic-use threshold."
CooldownSeconds = 8.0
CastTimeSeconds = 1.5
TargetMode = 2
TargetSelectionStyle = 0
Range = 0.0
EffectType = 2
BaseHealing = 300.0
AutoCastHealthThresholdPercent = 75.0
DesignerNotes = "Spell healing is intentionally separate from passive out-of-combat recovery so future Spirit scaling applies only to priest healing."
